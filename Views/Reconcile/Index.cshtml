@model IEnumerable<AFTRS.Models.Transaction>
@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "ReconciliationDashboard");
}

<div class="af-page-header">
    <div>
        <p class="af-kicker">@UiText.T(language, "RunEngine")</p>
        <h1 class="af-title">@UiText.T(language, "ReconciliationDashboard")</h1>
    </div>
    <div class="flex flex-wrap gap-2">
        <a asp-controller="Reports" asp-action="ReconciliationPdf" class="af-btn-secondary">@UiText.T(language, "ExportPdf")</a>
        <a asp-controller="Reports" asp-action="ReconciliationExcel" class="af-btn-secondary">@UiText.T(language, "ExportExcel")</a>
        <form asp-action="CategorizeOnly" method="post">@Html.AntiForgeryToken()<button type="submit" class="af-btn-secondary">@UiText.T(language, "Categorize")</button></form>
        <form asp-action="RunEngine" method="post" id="engineForm">@Html.AntiForgeryToken()<button type="submit" id="runBtn" class="af-btn-primary"><span id="btnText">@UiText.T(language, "RunReconciliationEngine")</span><span id="spinner" class="hidden animate-spin"><i class="fa-solid fa-circle-notch"></i></span></button></form>
    </div>
</div>

@if (TempData["Msg"] != null)
{
    <div class="af-alert">@TempData["Msg"]</div>
}

<div class="flex flex-wrap gap-3 mb-4">
    <span class="af-badge af-badge-green">@UiText.T(language, "AutoReconciled")</span>
    <span class="af-badge af-badge-yellow">@UiText.T(language, "ManualReconciled")</span>
    <span class="af-badge af-badge-red">@UiText.T(language, "Discrepancy")</span>
</div>

<div class="af-table-wrap">
    <table class="af-table">
        <thead>
            <tr>
                <th>@UiText.T(language, "Date")</th>
                <th>@UiText.T(language, "Description")</th>
                <th>@UiText.T(language, "Amount")</th>
                <th>@UiText.T(language, "Source")</th>
                <th>@UiText.T(language, "Category")</th>
                <th>@UiText.T(language, "Status")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var statusClass = item.Status == "Reconciled" ? (item.MatchMethod == "Manual" ? "af-badge-yellow" : "af-badge-green") : "af-badge-red";
                <tr>
                    <td>@item.TransactionDate.ToString("dd/MM/yyyy")</td>
                    <td>@item.Description</td>
                    <td class="font-black">@item.Amount.ToString("N2") LYD</td>
                    <td><span class="af-badge @(item.Source == "Bank" ? "af-badge-purple" : "af-badge-cyan")">@item.Source</span></td>
                    <td class="af-muted">@(item.Category?.Name ?? "-")</td>
                    <td><span class="af-badge @statusClass">@item.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    document.getElementById('engineForm').onsubmit = function() {
        document.getElementById('runBtn').disabled = true;
        document.getElementById('runBtn').classList.add('opacity-60', 'cursor-not-allowed');
        document.getElementById('btnText').innerText = "@UiText.T(language, "ProcessingTransactions")";
        document.getElementById('spinner').classList.remove('hidden');
    };
</script>
