@model IEnumerable<AFTRS.Models.ReconciliationBatch>

<div class="p-6">
    <h1 class="text-2xl font-bold mb-6">Historical Sessions Library</h1>

    <!-- Search Bar -->
    <form method="get" class="bg-white p-4 rounded-lg shadow mb-6 flex gap-4">
        <input type="text" name="searchTerm" placeholder="Search Session Name..." class="border p-2 rounded w-full">
        <input type="date" name="startDate" class="border p-2 rounded">
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Filter</button>
    </form>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var batch in Model)
        {
            <div class="bg-white p-6 rounded-xl shadow border hover:border-blue-500 transition">
                <h3 class="text-lg font-bold">@batch.Name</h3>
                <p class="text-sm text-gray-500">Finalized on: @batch.CreatedAt.ToShortDateString()</p>
                <p class="mt-2 font-semibold">@batch.Transactions.Count Transactions</p>
                
                <div class="mt-4 flex gap-2">
                    <a asp-action="BatchDetails" asp-route-id="@batch.Id" class="text-blue-600 font-bold">View Data</a>
                    <a asp-action="DownloadReport" asp-route-id="@batch.Id" class="text-green-600 font-bold ml-4">PDF Report</a>
                </div>
            </div>
        }
    </div>
</div>