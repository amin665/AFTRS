@model AFTRS.Models.ReconciliationBatch

<div class="p-6">
    <div class="flex justify-between items-center mb-6">
        <div>
            <a asp-action="Archive" class="text-blue-600 hover:underline">← Back to Archive</a>
            <h1 class="text-3xl font-bold mt-2">@Model.Name</h1>
            <p class="text-gray-500">Processed on @Model.CreatedAt.ToString("f")</p>
        </div>
        <a asp-action="DownloadReport" asp-route-id="@Model.Id" class="bg-green-600 text-white px-4 py-2 rounded-lg font-bold">
            📥 Download PDF Report
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Ledger Side -->
        <div class="bg-white rounded-xl shadow overflow-hidden border-t-4 border-blue-500">
            <h3 class="p-4 bg-gray-50 font-bold border-b">Internal Ledger Records</h3>
            <table class="min-w-full text-sm">
                <thead class="bg-gray-100">
                    <tr>
                        <th class="px-4 py-2 text-left">Date</th>
                        <th class="px-4 py-2 text-left">Description</th>
                        <th class="px-4 py-2 text-left">Amount</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @foreach (var t in Model.Transactions.Where(x => x.Source == "Ledger"))
                    {
                        <tr>
                            <td class="px-4 py-2">@t.TransactionDate.ToShortDateString()</td>
                            <td class="px-4 py-2">@t.Description</td>
                            <td class="px-4 py-2 font-semibold">@t.Amount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Bank Side -->
        <div class="bg-white rounded-xl shadow overflow-hidden border-t-4 border-purple-500">
            <h3 class="p-4 bg-gray-50 font-bold border-b">Bank Statement Records</h3>
            <table class="min-w-full text-sm">
                <thead class="bg-gray-100">
                    <tr>
                        <th class="px-4 py-2 text-left">Date</th>
                        <th class="px-4 py-2 text-left">Description</th>
                        <th class="px-4 py-2 text-left">Amount</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @foreach (var t in Model.Transactions.Where(x => x.Source == "Bank"))
                    {
                        <tr>
                            <td class="px-4 py-2">@t.TransactionDate.ToShortDateString()</td>
                            <td class="px-4 py-2">@t.Description</td>
                            <td class="px-4 py-2 font-semibold">@t.Amount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>