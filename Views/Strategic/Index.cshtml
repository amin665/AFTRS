@model IEnumerable<AFTRS.Models.BudgetTarget>
@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "StrategicTitle");
    var actuals = ViewBag.ActualSpending as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
    var categories = ViewBag.Categories as IEnumerable<AFTRS.Models.Category> ?? new List<AFTRS.Models.Category>();
    var now = DateTime.Today;
}

<div class="p-6">
    @if (TempData["Error"] != null)
{
    <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded shadow-sm flex justify-between">
        <span><i class="fa-solid fa-triangle-exclamation mr-2"></i> @TempData["Error"]</span>
        <button onclick="this.parentElement.remove()" class="text-red-500 font-bold">&times;</button>
    </div>
}
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-800">@UiText.T(language, "StrategicTitle")</h1>
        
        <div class="flex items-center gap-2">
            @if (User.HasPermission(AppPermissions.Reports))
            {
                <a asp-controller="Reports" asp-action="BudgetPdf" class="text-xs bg-gray-900 text-white px-3 py-2 rounded-lg font-bold hover:bg-black">@UiText.T(language, "ExportBudgetPdf")</a>
            }
            <span class="text-xs bg-slate-100 text-slate-700 px-3 py-2 rounded-lg font-bold">@UiText.T(language, "ChartsNote")</span>
        </div>
    </div>

    @if (TempData["Msg"] != null)
    {
        <div class="bg-purple-100 border-l-4 border-purple-500 text-purple-700 p-4 mb-6 rounded shadow-sm">
            @TempData["Msg"]
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- LEFT COLUMN: Configurations -->
        <div class="space-y-8">
            
            <!-- Budgeting: monthly targets per category -->
            <div class="bg-white p-6 rounded-xl shadow-md border-t-4 border-blue-600">
                <h2 class="text-xl font-bold mb-4">@UiText.T(language, "SetMonthlyBudgets")</h2>
                <form asp-action="SetBudget" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-sm font-medium text-gray-700">@UiText.T(language, "CategoryName")</label>
                        <select name="categoryId" class="w-full border rounded-lg p-2 bg-gray-50">
                            @foreach (var c in categories)
                            {
                                <option value="@c.CategoryID">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-700">@UiText.T(language, "Month")</label>
                            <input type="number" name="targetMonth" min="1" max="12" value="@now.Month" class="w-full border rounded-lg p-2" required />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">@UiText.T(language, "Year")</label>
                            <input type="number" name="targetYear" min="2000" max="2100" value="@now.Year" class="w-full border rounded-lg p-2" required />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">@UiText.T(language, "LimitLyd")</label>
                        <input type="number" name="targetAmount" step="0.01" class="w-full border rounded-lg p-2" required />
                    </div>
                    <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg font-bold hover:bg-blue-700">@UiText.T(language, "SaveBudget")</button>
                </form>
            </div>

            <div class="bg-white p-6 rounded-xl shadow-md border-t-4 border-purple-600">
                <h2 class="text-xl font-bold mb-2">@UiText.T(language, "HeuristicsDictionary")</h2>
                <p class="text-sm text-gray-600 mb-4">@UiText.T(language, "HeuristicsHelp")</p>
                <form asp-action="AddCategory" method="post" class="space-y-3 mb-5">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-sm font-medium text-gray-700">@UiText.T(language, "Category")</label>
                        <input type="text" name="name" maxlength="50" class="w-full border rounded-lg p-2" placeholder="Utilities" required />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">@UiText.T(language, "KeywordRule")</label>
                        <input type="text" name="keywordRule" maxlength="100" class="w-full border rounded-lg p-2" placeholder="LTT" />
                    </div>
                    <button type="submit" class="w-full bg-purple-600 text-white py-2 rounded-lg font-bold hover:bg-purple-700">@UiText.T(language, "SaveCategoryRule")</button>
                </form>
                @if (!categories.Any())
                {
                    <p class="text-sm text-gray-400 italic">@UiText.T(language, "NoCategoryRules")</p>
                }
                else
                {
                    <div class="space-y-2 text-sm">
                        @foreach (var c in categories)
                        {
                            <div class="flex justify-between border rounded-lg px-3 py-2">
                                <span class="font-medium">@c.Name</span>
                                <code class="text-gray-500">@(c.KeywordRule ?? "-")</code>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT COLUMN: Visualization -->
        <div class="lg:col-span-2 space-y-8">
            <!-- Cash Flow Projection (FR-20) -->
            <div class="bg-white p-6 rounded-xl shadow-md">
                <div class="flex justify-between items-center mb-4 gap-4">
                    <h2 class="text-xl font-bold">@UiText.T(language, "CashFlowTitle")</h2>
                    <div class="flex items-center gap-2">
                        <label for="projMonths" class="text-xs text-gray-600">@UiText.T(language, "Projection"):</label>
                        <select id="projMonths" class="border rounded px-2 py-1 text-xs">
                            <option value="3" selected>@UiText.T(language, "Months3")</option>
                            <option value="6">@UiText.T(language, "Months6")</option>
                        </select>
                        <span class="text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded">@UiText.T(language, "HistoricalProjected")</span>
                    </div>
                </div>
                <canvas id="cashFlowChart" height="150"></canvas>
            </div>

            <!-- Budget vs Actual Bar Chart -->
            <div class="bg-white p-6 rounded-xl shadow-md">
                <h2 class="text-xl font-bold mb-4">@UiText.T(language, "BudgetActualTitle")</h2>
                @if(!Model.Any()){
                    <p class="text-gray-400 italic">@UiText.T(language, "NoBudgets")</p>
                } else {
                    <canvas id="budgetChart" height="120"></canvas>
                }
                <!-- Progress-bar variance summary -->
                <div class="mt-6 space-y-4">
                    @foreach (var b in Model) {
                        var spent = actuals.ContainsKey(b.CategoryID) ? actuals[b.CategoryID] : 0;
                        var percent = b.TargetAmount > 0 ? (spent / b.TargetAmount) * 100 : 0;
                        var color = percent > 100 ? "bg-red-500" : "bg-green-500";
                        <div>
                            <div class="flex justify-between mb-1">
                                <span class="text-sm font-medium">@b.Category?.Name</span>
                                <span class="text-sm @(percent > 100 ? "text-red-600 font-bold" : "text-gray-600")">
                                    @spent.ToString("N2") / @b.TargetAmount.ToString("N2") LYD
                                    @if (percent > 100) { <span class="ml-1 text-xs">@UiText.T(language, "OverBudget")</span> }
                                </span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-3">
                                <div class="@color h-3 rounded-full transition-all duration-1000" style="width: @(percent > 100 ? 100 : percent)%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function loadCashFlow() {
            const months = document.getElementById('projMonths')?.value || '3';
            fetch(`/Strategic/GetCashFlowData?projectionMonths=${encodeURIComponent(months)}`)
                .then(res => res.json())
                .then(data => {
                const histLabels = data.past.map(d => `${d.year}-${String(d.month).padStart(2,'0')}`);
                const histValues = data.past.map(d => d.total);
                const projLabels = data.projected.map(d => `${d.year}-${String(d.month).padStart(2,'0')}`);
                const projValues = data.projected.map(d => d.total);

                const allLabels = [...histLabels, ...projLabels];

                const ctx = document.getElementById('cashFlowChart').getContext('2d');
                if (window.__cashFlowChart) window.__cashFlowChart.destroy();
                window.__cashFlowChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: allLabels,
                        datasets: [
                            {
                                label: 'Historical (LYD)',
                                data: [...histValues, ...Array(projLabels.length).fill(null)],
                                borderColor: 'rgb(37, 99, 235)',
                                backgroundColor: 'rgba(37, 99, 235, 0.1)',
                                fill: true,
                                tension: 0.4,
                                spanGaps: false
                            },
                            {
                                label: '3-Month Projection (LYD)',
                                data: [...Array(histLabels.length).fill(null), ...projValues],
                                borderColor: 'rgb(234, 179, 8)',
                                backgroundColor: 'rgba(234, 179, 8, 0.1)',
                                borderDash: [6, 3],
                                fill: true,
                                tension: 0.4,
                                spanGaps: false
                            }
                        ]
                    },
                    options: { responsive: true }
                });
            });
        }

        loadCashFlow();
        document.getElementById('projMonths')?.addEventListener('change', loadCashFlow);

        // UC-12: Budget vs Actual Bar Chart
        const budgetCanvas = document.getElementById('budgetChart');
        if (budgetCanvas) {
            const budgetLabels = [@Html.Raw(string.Join(",", Model.Select(b => $"\"{b.Category?.Name}\"")))];
            const budgetLimits = [@Html.Raw(string.Join(",", Model.Select(b => b.TargetAmount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))))];
            const budgetActuals = [@Html.Raw(string.Join(",", Model.Select(b => {
                var s = actuals.ContainsKey(b.CategoryID) ? actuals[b.CategoryID] : 0;
                return s.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
            })))];

            new Chart(budgetCanvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: budgetLabels,
                    datasets: [
                        { label: 'Budget Target (LYD)', data: budgetLimits, backgroundColor: 'rgba(37, 99, 235, 0.6)' },
                        { label: 'Actual Spending (LYD)', data: budgetActuals, backgroundColor: 'rgba(239, 68, 68, 0.6)' }
                    ]
                },
                options: { responsive: true, scales: { y: { beginAtZero: true } } }
            });
        }
    </script>
}
