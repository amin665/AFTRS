@using AFTRS.Infrastructure
@{
    var uiLanguage = UiText.Language(Context.Request);
    var uiTheme = UiText.Theme(Context.Request);
    var isArabic = uiLanguage == "ar";
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var sidePosition = isArabic ? "right-0" : "left-0";
    var hiddenTransform = isArabic ? "translate-x-full" : "-translate-x-full";
    var mainOffset = isArabic ? "md:mr-72" : "md:ml-72";
    var hideFooter = ViewData["HideFooter"] as bool? == true;
}
<!DOCTYPE html>
<html lang="@uiLanguage" dir="@(isArabic ? "rtl" : "ltr")" data-theme="@uiTheme" class="@(uiTheme == "dark" ? "dark" : "")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AFTRS</title>
    <script>
        window.tailwind = { config: { darkMode: 'class' } };
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (isAuthenticated)
    {
        <div class="af-shell">
            <aside class="af-sidebar fixed inset-y-0 @sidePosition transition-transform duration-300 transform @hiddenTransform md:translate-x-0 z-50" id="sidebar">
                <div class="af-brand">
                    <div class="af-brand-mark">A</div>
                    <div>
                        <div class="af-brand-title">AFTRS</div>
                        <div class="af-brand-subtitle">@UiText.T(uiLanguage, "ReconciliationDashboard")</div>
                    </div>
                </div>

                <nav class="af-sidebar-nav py-4">
                    <a asp-controller="Home" asp-action="Index" class="af-nav-link" data-interface-name="@UiText.T(uiLanguage, "Dashboard") Dashboard">
                        <i class="fa-solid fa-gauge-high"></i> <span>@UiText.T(uiLanguage, "Dashboard")</span>
                    </a>

                    <div class="af-nav-section">@UiText.T(uiLanguage, "FinancialOperations")</div>
                    @if (User.HasPermission(AppPermissions.Import))
                    {
                        <a asp-controller="Import" asp-action="Index" class="af-nav-link" data-interface-name="@UiText.T(uiLanguage, "DataImport") Data Import Import">
                            <i class="fa-solid fa-file-import"></i> <span>@UiText.T(uiLanguage, "DataImport")</span>
                        </a>
                    }
                    @if (User.HasPermission(AppPermissions.Reconcile))
                    {
                        <a asp-controller="Reconcile" asp-action="Index" class="af-nav-link" data-interface-name="@UiText.T(uiLanguage, "RunEngine") Run Engine Reconciliation">
                            <i class="fa-solid fa-microchip"></i> <span>@UiText.T(uiLanguage, "RunEngine")</span>
                        </a>
                    }
                    @if (User.HasPermission(AppPermissions.ResolveDiscrepancies))
                    {
                        <a asp-controller="Resolve" asp-action="Index" class="af-nav-link" data-interface-name="@UiText.T(uiLanguage, "Discrepancies") Discrepancies Resolve Workbench">
                            <i class="fa-solid fa-screwdriver-wrench"></i> <span>@UiText.T(uiLanguage, "Discrepancies")</span>
                        </a>
                    }
                    @if (User.HasPermission(AppPermissions.StrategicIntelligence))
                    {
                        <a asp-controller="Strategic" asp-action="Index" class="af-nav-link" data-interface-name="@UiText.T(uiLanguage, "Intelligence") Intelligence Strategic">
                            <i class="fa-solid fa-chart-line"></i> <span>@UiText.T(uiLanguage, "Intelligence")</span>
                        </a>
                    }
                    @if (User.HasPermission(AppPermissions.Templates))
                    {
                        <a asp-controller="Templates" asp-action="Index" class="af-nav-link" data-interface-name="@UiText.T(uiLanguage, "Templates") Templates">
                            <i class="fa-solid fa-repeat"></i> <span>@UiText.T(uiLanguage, "Templates")</span>
                        </a>
                    }
                    <a asp-controller="Help" asp-action="Index" class="af-nav-link" data-interface-name="@UiText.T(uiLanguage, "HelpCsvGuide") Help CSV Guide">
                        <i class="fa-solid fa-circle-question"></i> <span>@UiText.T(uiLanguage, "HelpCsvGuide")</span>
                    </a>
                    @if (User.HasPermission(AppPermissions.Sessions))
                    {
                        <a asp-controller="Sessions" asp-action="Index" class="af-nav-link" data-interface-name="@UiText.T(uiLanguage, "Sessions") Sessions Archive">
                            <i class="fa-solid fa-box-archive"></i> <span>@UiText.T(uiLanguage, "Sessions")</span>
                        </a>
                    }

                    @if (User?.HasClaim("role", "Admin") == true)
                    {
                        <div class="af-nav-section">@UiText.T(uiLanguage, "AdminSecurity")</div>
                        <a asp-controller="Admin" asp-action="SecurityLogs" class="af-nav-link" data-interface-name="@UiText.T(uiLanguage, "SecurityLogs") Security Logs">
                            <i class="fa-solid fa-shield-halved"></i> <span>@UiText.T(uiLanguage, "SecurityLogs")</span>
                        </a>
                        <a asp-controller="Admin" asp-action="Users" class="af-nav-link" data-interface-name="@UiText.T(uiLanguage, "UserManagement") Users Accounts Permissions">
                            <i class="fa-solid fa-users-gear"></i> <span>@UiText.T(uiLanguage, "UserManagement")</span>
                        </a>
                        <a asp-controller="Admin" asp-action="AuditTrail" class="af-nav-link" data-interface-name="@UiText.T(uiLanguage, "AuditTrail") Audit Trail Financial Audit">
                            <i class="fa-solid fa-list-check"></i> <span>@UiText.T(uiLanguage, "AuditTrail")</span>
                        </a>
                    }
                </nav>
                <div class="af-sidebar-bottom py-4">
                    <a asp-controller="Settings" asp-action="Index" class="af-nav-link" data-interface-name="@UiText.T(uiLanguage, "Settings") Settings Preferences">
                        <i class="fa-solid fa-gear"></i> <span>@UiText.T(uiLanguage, "Settings")</span>
                    </a>
                </div>
            </aside>

            <div class="@mainOffset af-main flex flex-col">
                <header class="af-topbar">
                    <div class="flex items-center gap-4">
                        <button class="md:hidden af-btn-secondary !min-h-0 !p-3" type="button" onclick="toggleSidebar()" aria-label="Toggle navigation">
                            <i class="fa-solid fa-bars"></i>
                        </button>
                        <div class="af-search" id="interfaceSearch">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="search" id="interfaceSearchInput" placeholder="@UiText.T(uiLanguage, "Dashboard") / AFTRS" autocomplete="off" />
                            <div class="af-search-results hidden" id="interfaceSearchResults"></div>
                        </div>
                    </div>

                    <div class="flex items-center gap-4">
                        <div class="@(isArabic ? "text-left" : "text-right") hidden sm:block">
                            <p class="text-sm font-black">@User?.Identity?.Name</p>
                            <p class="af-kicker">@((User?.HasClaim("role", "Admin") == true) ? UiText.T(uiLanguage, "SystemAdministrator") : UiText.T(uiLanguage, "FinancialManager"))</p>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="af-btn-secondary !min-h-0 !p-3" title="@UiText.T(uiLanguage, "Logout")">
                                <i class="fa-solid fa-power-off"></i>
                            </button>
                        </form>
                    </div>
                </header>

                <main class="af-page flex-grow">
                    @RenderBody()
                </main>

                @if (!hideFooter)
                {
                    <footer class="af-footer p-6 text-center text-sm">
                        &copy; 2026 AFTRS - Libyan International Medical University Capstone Project
                    </footer>
                }
            </div>
        </div>
    }
    else
    {
        <main>
            @RenderBody()
        </main>
    }

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            if (!sidebar) return;
            const hiddenClass = document.documentElement.dir === 'rtl' ? 'translate-x-full' : '-translate-x-full';
            sidebar.classList.toggle(hiddenClass);
        }

        (function setupInterfaceSearch() {
            const input = document.getElementById('interfaceSearchInput');
            const results = document.getElementById('interfaceSearchResults');
            if (!input || !results) return;

            const items = Array.from(document.querySelectorAll('[data-interface-name]')).map(link => ({
                label: link.innerText.trim(),
                terms: link.dataset.interfaceName.toLowerCase(),
                href: link.href
            }));

            function render(matches) {
                results.innerHTML = '';
                if (!matches.length) {
                    results.classList.add('hidden');
                    return;
                }

                matches.slice(0, 6).forEach(item => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'af-search-result';
                    button.textContent = item.label;
                    button.addEventListener('click', () => window.location.href = item.href);
                    results.appendChild(button);
                });
                results.classList.remove('hidden');
            }

            input.addEventListener('input', () => {
                const query = input.value.trim().toLowerCase();
                render(query ? items.filter(item => item.terms.includes(query) || item.label.toLowerCase().includes(query)) : []);
            });

            input.addEventListener('keydown', event => {
                if (event.key !== 'Enter') return;
                const first = results.querySelector('.af-search-result');
                if (first) {
                    event.preventDefault();
                    first.click();
                }
            });

            document.addEventListener('click', event => {
                if (!document.getElementById('interfaceSearch')?.contains(event.target)) results.classList.add('hidden');
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
