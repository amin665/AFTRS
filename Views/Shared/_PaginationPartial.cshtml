@using AFTRS.Models
@{
    var language = UiText.Language(Context.Request);
}

@if (Model != null && Model.TotalPages > 1)
{
    <div class="af-pagination-container mt-6">
        <div class="flex items-center justify-between flex-wrap gap-4">
            <!-- Pagination Info -->
            <div class="af-muted text-sm">
                @UiText.T(language, "Page") <strong>@Model.CurrentPage</strong> @UiText.T(language, "Of") <strong>@Model.TotalPages</strong>
                (@Model.StartRowNumber - @Model.EndRowNumber @UiText.T(language, "Of") @Model.TotalItems)
            </div>

            <!-- Pagination Controls -->
            <nav class="af-pagination-nav" aria-label="Pagination navigation">
                <ul class="af-pagination-list">
                    <!-- Previous Button -->
                    @if (Model.HasPreviousPage)
                    {
                        <li class="af-pagination-item">
                            <a class="af-pagination-link" href="?page=1" title="First page">
                                <i class="fa-solid fa-angle-double-left"></i>
                            </a>
                        </li>
                        <li class="af-pagination-item">
                            <a class="af-pagination-link" href="?page=@(Model.CurrentPage - 1)" title="Previous page">
                                <i class="fa-solid fa-angle-left"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="af-pagination-item">
                            <span class="af-pagination-link af-pagination-disabled">
                                <i class="fa-solid fa-angle-double-left"></i>
                            </span>
                        </li>
                        <li class="af-pagination-item">
                            <span class="af-pagination-link af-pagination-disabled">
                                <i class="fa-solid fa-angle-left"></i>
                            </span>
                        </li>
                    }

                    <!-- Page Numbers -->
                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                        if (startPage > 1)
                        {
                            <li class="af-pagination-item">
                                <a class="af-pagination-link" href="?page=1">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="af-pagination-item af-pagination-ellipsis">
                                    <span>...</span>
                                </li>
                            }
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            if (i == Model.CurrentPage)
                            {
                                <li class="af-pagination-item">
                                    <span class="af-pagination-link af-pagination-active" aria-current="page">@i</span>
                                </li>
                            }
                            else
                            {
                                <li class="af-pagination-item">
                                    <a class="af-pagination-link" href="?page=@i">@i</a>
                                </li>
                            }
                        }

                        if (endPage < Model.TotalPages)
                        {
                            if (endPage < Model.TotalPages - 1)
                            {
                                <li class="af-pagination-item af-pagination-ellipsis">
                                    <span>...</span>
                                </li>
                            }
                            <li class="af-pagination-item">
                                <a class="af-pagination-link" href="?page=@Model.TotalPages">@Model.TotalPages</a>
                            </li>
                        }
                    }

                    <!-- Next Button -->
                    @if (Model.HasNextPage)
                    {
                        <li class="af-pagination-item">
                            <a class="af-pagination-link" href="?page=@(Model.CurrentPage + 1)" title="Next page">
                                <i class="fa-solid fa-angle-right"></i>
                            </a>
                        </li>
                        <li class="af-pagination-item">
                            <a class="af-pagination-link" href="?page=@Model.TotalPages" title="Last page">
                                <i class="fa-solid fa-angle-double-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="af-pagination-item">
                            <span class="af-pagination-link af-pagination-disabled">
                                <i class="fa-solid fa-angle-right"></i>
                            </span>
                        </li>
                        <li class="af-pagination-item">
                            <span class="af-pagination-link af-pagination-disabled">
                                <i class="fa-solid fa-angle-double-right"></i>
                            </span>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
}
