@model ErrorViewModel
@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "Error");
}

<h1 class="text-danger">@UiText.T(language, "Error")</h1>
<h2 class="text-danger">@UiText.T(language, "ErrorOccurred")</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@UiText.T(language, "RequestId"):</strong> <code>@Model.RequestId</code>
    </p>
}

