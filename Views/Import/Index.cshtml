@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "DataImport");
    var uploadHistory = ViewBag.UploadHistory as IEnumerable<AFTRS.Models.FileUploadRecord> ?? new List<AFTRS.Models.FileUploadRecord>();
}

<div class="af-page-header">
    <div>
        <p class="af-kicker">SHA-256 / CSV / XLSX</p>
        <h1 class="af-title">@UiText.T(language, "DataImport")</h1>
        <p class="af-subtitle">@UiText.T(language, "MaxUploadNotice") 25 MB @UiText.T(language, "PerUploadFormats") .csv / .xlsx</p>
    </div>
    <a asp-controller="Help" asp-action="Index" class="af-btn-secondary"><i class="fa-solid fa-circle-question"></i> @UiText.T(language, "ViewCsvGuide")</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="af-alert af-alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="af-alert af-alert-danger"><i class="fa-solid fa-triangle-exclamation"></i> @TempData["Error"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="af-alert af-alert-warning"><i class="fa-solid fa-circle-info"></i> @TempData["Warning"]</div>
}

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <section class="af-panel af-glow-cyan text-center">
        <i class="fa-solid fa-book text-4xl text-cyan-400 mb-4"></i>
        <h2 class="text-2xl font-black mb-2">@UiText.T(language, "InternalLedger")</h2>
        <p class="af-muted mb-6">CSV / XLSX</p>
        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="sourceType" value="Ledger" />
            <input type="file" name="file" accept=".csv,.xlsx" class="block w-full text-sm" />
            <button type="submit" class="af-btn-primary w-full">@UiText.T(language, "UploadLedger")</button>
        </form>
    </section>

    <section class="af-panel af-glow-green text-center">
        <i class="fa-solid fa-building-columns text-4xl text-green-400 mb-4"></i>
        <h2 class="text-2xl font-black mb-2">@UiText.T(language, "BankStatement")</h2>
        <p class="af-muted mb-6">CSV / XLSX</p>
        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="sourceType" value="Bank" />
            <input type="file" name="file" accept=".csv,.xlsx" class="block w-full text-sm" />
            <button type="submit" class="af-btn-success w-full">@UiText.T(language, "UploadBankStatement")</button>
        </form>
    </section>
</div>

<section class="mt-6">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-black">@UiText.T(language, "RecentUploads")</h2>
        <span class="af-badge af-badge-cyan">@uploadHistory.Count() @UiText.T(language, "Records")</span>
    </div>
    @if (!uploadHistory.Any())
    {
        <div class="af-card af-muted">@UiText.T(language, "NoFilesUploaded")</div>
    }
    else
    {
        <div class="af-table-wrap">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>@UiText.T(language, "FileName")</th>
                        <th>@UiText.T(language, "Type")</th>
                        <th>@UiText.T(language, "UploadedAt")</th>
                        <th>SHA-256</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rec in uploadHistory)
                    {
                        <tr>
                            <td class="font-bold">@rec.FileName</td>
                            <td><span class="af-badge @(rec.Source == "Ledger" ? "af-badge-cyan" : "af-badge-purple")">@rec.Source</span></td>
                            <td class="af-muted">@rec.UploadedAt.ToString("g")</td>
                            <td class="font-mono text-xs af-muted" title="@rec.FileHash">@rec.FileHash[..16]...</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
