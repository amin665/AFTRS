@{
    ViewData["Title"] = "Data Import";
    var uploadHistory = ViewBag.UploadHistory as IEnumerable<AFTRS.Models.FileUploadRecord> ?? new List<AFTRS.Models.FileUploadRecord>();
}

<div class="max-w-4xl mx-auto mt-10">
    <h1 class="text-3xl font-bold mb-6 text-gray-800">Data Import</h1>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6 flex items-center">
            <i class="fa-solid fa-triangle-exclamation mr-2"></i>
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.ActiveBatchName == null)
    {
        <!-- STEP 1: CREATE SESSION -->
        <div class="bg-white p-10 rounded-xl shadow-lg border-2 border-blue-500">
            <h2 class="text-xl font-bold mb-4">Step 1: Start a New Reconciliation Session</h2>
            <p class="text-gray-600 mb-6">Before uploading files, give this session a name (e.g., "January 2026 Audit").</p>
            
            <form asp-action="CreateBatch" method="post" class="flex gap-4">
                @Html.AntiForgeryToken()
                <input type="text" name="batchName" required placeholder="Session Name..." 
                       class="flex-grow border-2 border-gray-200 rounded-lg px-4 py-2 focus:border-blue-500 outline-none transition" />
                <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg font-bold hover:bg-blue-700">
                    Start Session
                </button>
            </form>
        </div>
    }
    else
    {
        <!-- STEP 2: UPLOAD FILES -->
        <div class="bg-blue-50 p-6 rounded-xl border border-blue-200 mb-8 flex justify-between items-center">
            <div>
                <p class="text-sm font-bold text-blue-600 uppercase">Active Session</p>
                <h2 class="text-2xl font-black text-gray-800">@ViewBag.ActiveBatchName</h2>
            </div>
            <form asp-action="ClearCurrentBatch" method="post" onsubmit="return confirm('Delete this session and all uploaded data?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="text-red-600 hover:text-red-800 font-bold">🗑️ Cancel Session</button>
            </form>
        </div>

        <!-- FR-08 notice -->
        <div class="bg-yellow-50 border-l-4 border-yellow-400 p-3 mb-6 text-sm text-yellow-800 flex items-center gap-2">
            <i class="fa-solid fa-circle-info"></i>
            <span>Maximum file size: <strong>25 MB</strong> per upload. Accepted formats: <strong>.csv</strong> and <strong>.xlsx</strong>.
            <a asp-controller="Help" asp-action="Index" class="underline ml-1">View CSV format guide →</a></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Internal Ledger -->
            <div class="bg-white p-8 rounded-xl shadow-md border-2 border-dashed border-blue-200 text-center">
                <h3 class="text-lg font-semibold mb-4 text-blue-800">1. Internal Ledger (CSV/XLSX)</h3>
                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="sourceType" value="Ledger" />
                    <input type="file" name="file" accept=".csv,.xlsx" class="mb-4 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
                    <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg font-bold">Upload Ledger</button>
                </form>
            </div>

            <!-- Bank Statement -->
            <div class="bg-white p-8 rounded-xl shadow-md border-2 border-dashed border-green-200 text-center">
                <h3 class="text-lg font-semibold mb-4 text-green-800">2. Bank Statement (CSV/XLSX)</h3>
                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="sourceType" value="Bank" />
                    <input type="file" name="file" accept=".csv,.xlsx" class="mb-4 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100" />
                    <button type="submit" class="w-full bg-green-600 text-white py-2 rounded-lg font-bold">Upload Bank Statement</button>
                </form>
            </div>
        </div>

        <!-- FR-09 / Wireframe B.1: Upload History Grid -->
        <div class="mt-10">
            <h2 class="text-lg font-bold text-gray-700 mb-4">Upload History (Current Session)</h2>
            @if (!uploadHistory.Any())
            {
                <p class="text-gray-400 italic text-sm">No files uploaded yet in this session.</p>
            }
            else
            {
                <table class="min-w-full bg-white rounded-xl shadow text-sm">
                    <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
                        <tr>
                            <th class="px-4 py-3 text-left">File Name</th>
                            <th class="px-4 py-3 text-left">Type</th>
                            <th class="px-4 py-3 text-left">Uploaded By</th>
                            <th class="px-4 py-3 text-left">Uploaded At</th>
                            <th class="px-4 py-3 text-left">SHA-256</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y">
                        @foreach (var rec in uploadHistory)
                        {
                            <tr>
                                <td class="px-4 py-3 font-medium">@rec.FileName</td>
                                <td class="px-4 py-3">
                                    <span class="px-2 py-1 rounded text-xs @(rec.Source == "Ledger" ? "bg-blue-100 text-blue-700" : "bg-purple-100 text-purple-700")">
                                        @rec.Source
                                    </span>
                                </td>
                                <td class="px-4 py-3">@rec.UploadedBy</td>
                                <td class="px-4 py-3 text-gray-500">@rec.UploadedAt.ToString("g")</td>
                                <td class="px-4 py-3 font-mono text-xs text-gray-400 truncate max-w-xs" title="@rec.FileHash">@rec.FileHash[..16]…</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</div>