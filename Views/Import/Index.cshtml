@{
    ViewData["Title"] = "Data Import";
}

<div class="max-w-4xl mx-auto mt-10">
    <h1 class="text-3xl font-bold mb-6 text-gray-800">Data Import</h1>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6 flex items-center">
            <i class="fa-solid fa-triangle-exclamation mr-2"></i>
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.ActiveBatchName == null)
    {
        <!-- STEP 1: CREATE SESSION -->
        <div class="bg-white p-10 rounded-xl shadow-lg border-2 border-blue-500">
            <h2 class="text-xl font-bold mb-4">Step 1: Start a New Reconciliation Session</h2>
            <p class="text-gray-600 mb-6">Before uploading files, give this session a name (e.g., "January 2026 Audit").</p>
            
            <form asp-action="CreateBatch" method="post" class="flex gap-4">
                @Html.AntiForgeryToken()
                <input type="text" name="batchName" required placeholder="Session Name..." 
                       class="flex-grow border-2 border-gray-200 rounded-lg px-4 py-2 focus:border-blue-500 outline-none transition" />
                <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg font-bold hover:bg-blue-700">
                    Start Session
                </button>
            </form>
        </div>
    }
    else
    {
        <!-- STEP 2: UPLOAD FILES -->
        <div class="bg-blue-50 p-6 rounded-xl border border-blue-200 mb-8 flex justify-between items-center">
            <div>
                <p class="text-sm font-bold text-blue-600 uppercase">Active Session</p>
                <h2 class="text-2xl font-black text-gray-800">@ViewBag.ActiveBatchName</h2>
            </div>
            <form asp-action="ClearCurrentBatch" method="post" onsubmit="return confirm('Delete this session and all uploaded data?')">
                <button type="submit" class="text-red-600 hover:text-red-800 font-bold">🗑️ Cancel Session</button>
            </form>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Internal Ledger -->
            <div class="bg-white p-8 rounded-xl shadow-md border-2 border-dashed border-blue-200 text-center">
                <h3 class="text-lg font-semibold mb-4 text-blue-800">1. Internal Ledger</h3>
                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="sourceType" value="Ledger" />
                    <input type="file" name="file" class="mb-4 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
                    <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg font-bold">Upload Ledger</button>
                </form>
            </div>

            <!-- Bank Statement -->
            <div class="bg-white p-8 rounded-xl shadow-md border-2 border-dashed border-green-200 text-center">
                <h3 class="text-lg font-semibold mb-4 text-green-800">2. Bank Statement</h3>
                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="sourceType" value="Bank" />
                    <input type="file" name="file" class="mb-4 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100" />
                    <button type="submit" class="w-full bg-green-600 text-white py-2 rounded-lg font-bold">Upload Bank Statement</button>
                </form>
            </div>
        </div>
    }
</div>