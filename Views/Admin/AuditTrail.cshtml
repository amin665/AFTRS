@model IEnumerable<AFTRS.Models.FinancialAuditLog>
@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "FinancialAuditTrail");
}

<div class="af-page-header">
    <div>
        <p class="af-kicker">@UiText.T(language, "AuditTrail")</p>
        <h1 class="af-title">@UiText.T(language, "FinancialAuditTrail")</h1>
        <p class="af-subtitle">@UiText.T(language, "AuditTrailNote")</p>
    </div>
</div>

<div class="af-alert"><strong>@UiText.T(language, "Note"):</strong> @UiText.T(language, "AuditTrailNote")</div>
<div class="af-table-wrap">
    <table class="af-table">
        <thead><tr><th>@UiText.T(language, "Timestamp")</th><th>@UiText.T(language, "User")</th><th>@UiText.T(language, "Transaction")</th><th>@UiText.T(language, "OldStatus")</th><th>@UiText.T(language, "NewStatus")</th><th>@UiText.T(language, "Justification")</th></tr></thead>
        <tbody>
            @foreach (var entry in Model)
            {
                <tr>
                    <td class="af-muted">@entry.Timestamp.ToString("g")</td>
                    <td class="font-bold">@entry.User?.Username</td>
                    <td>@UiText.T(language, "Transaction") #@entry.TransactionID</td>
                    <td>@entry.OldStatus</td>
                    <td><span class="af-badge af-badge-green">@entry.NewStatus</span></td>
                    <td class="italic af-muted">"@entry.Justification"</td>
                </tr>
            }
        </tbody>
    </table>
</div>
