@model IEnumerable<AFTRS.Models.FinancialAuditLog>
@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "FinancialAuditTrail");
}

<div class="af-page-header">
    <div>
        <p class="af-kicker">@UiText.T(language, "AuditTrail")</p>
        <h1 class="af-title">@UiText.T(language, "FinancialAuditTrail")</h1>
        <p class="af-subtitle">@UiText.T(language, "AuditTrailNote")</p>
    </div>
</div>

<div class="af-alert"><strong>@UiText.T(language, "Note"):</strong> @UiText.T(language, "AuditTrailNote")</div>
<div class="af-table-wrap">
    <table class="af-table">
        <thead><tr><th>@UiText.T(language, "Timestamp")</th><th>@UiText.T(language, "User")</th><th>@UiText.T(language, "Transaction")</th><th>@UiText.T(language, "OldStatus")</th><th>@UiText.T(language, "NewStatus")</th><th>@UiText.T(language, "Justification")</th></tr></thead>
        <tbody>
            @foreach (var entry in Model)
            {
                <tr>
                    <td class="af-muted">@entry.Timestamp.ToString("g")</td>
                    <td class="font-bold">@entry.User?.Username</td>
                    <td>@UiText.T(language, "Transaction") #@entry.TransactionID</td>
                    <td>@entry.OldStatus</td>
                    <td><span class="af-badge af-badge-green">@entry.NewStatus</span></td>
                    <td class="italic af-muted">"@entry.Justification"</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{
    var pagination = ViewBag.Pagination as AFTRS.Models.PaginationMetadata;
}

@if (pagination != null && pagination.TotalPages > 1)
{
    <div class="af-pagination-container mt-6">
        <div class="flex items-center justify-between flex-wrap gap-4">
            <!-- Pagination Info -->
            <div class="af-muted text-sm">
                @UiText.T(language, "Page") <strong>@pagination.CurrentPage</strong> @UiText.T(language, "Of") <strong>@pagination.TotalPages</strong>
                (@pagination.StartRowNumber - @pagination.EndRowNumber @UiText.T(language, "Of") @pagination.TotalItems)
            </div>

            <!-- Pagination Controls -->
            <nav class="af-pagination-nav" aria-label="Pagination navigation">
                <ul class="af-pagination-list">
                    <!-- Previous Button -->
                    @if (pagination.HasPreviousPage)
                    {
                        <li class="af-pagination-item">
                            <a class="af-pagination-link" href="?page=1" title="First page">
                                <i class="fa-solid fa-angle-double-left"></i>
                            </a>
                        </li>
                        <li class="af-pagination-item">
                            <a class="af-pagination-link" href="?page=@(pagination.CurrentPage - 1)" title="Previous page">
                                <i class="fa-solid fa-angle-left"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="af-pagination-item">
                            <span class="af-pagination-link af-pagination-disabled">
                                <i class="fa-solid fa-angle-double-left"></i>
                            </span>
                        </li>
                        <li class="af-pagination-item">
                            <span class="af-pagination-link af-pagination-disabled">
                                <i class="fa-solid fa-angle-left"></i>
                            </span>
                        </li>
                    }

                    <!-- Page Numbers -->
                    @{
                        int startPage = Math.Max(1, pagination.CurrentPage - 2);
                        int endPage = Math.Min(pagination.TotalPages, pagination.CurrentPage + 2);

                        if (startPage > 1)
                        {
                            <li class="af-pagination-item">
                                <a class="af-pagination-link" href="?page=1">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="af-pagination-item af-pagination-ellipsis">
                                    <span>...</span>
                                </li>
                            }
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            if (i == pagination.CurrentPage)
                            {
                                <li class="af-pagination-item">
                                    <span class="af-pagination-link af-pagination-active" aria-current="page">@i</span>
                                </li>
                            }
                            else
                            {
                                <li class="af-pagination-item">
                                    <a class="af-pagination-link" href="?page=@i">@i</a>
                                </li>
                            }
                        }

                        if (endPage < pagination.TotalPages)
                        {
                            if (endPage < pagination.TotalPages - 1)
                            {
                                <li class="af-pagination-item af-pagination-ellipsis">
                                    <span>...</span>
                                </li>
                            }
                            <li class="af-pagination-item">
                                <a class="af-pagination-link" href="?page=@pagination.TotalPages">@pagination.TotalPages</a>
                            </li>
                        }
                    }

                    <!-- Next Button -->
                    @if (pagination.HasNextPage)
                    {
                        <li class="af-pagination-item">
                            <a class="af-pagination-link" href="?page=@(pagination.CurrentPage + 1)" title="Next page">
                                <i class="fa-solid fa-angle-right"></i>
                            </a>
                        </li>
                        <li class="af-pagination-item">
                            <a class="af-pagination-link" href="?page=@pagination.TotalPages" title="Last page">
                                <i class="fa-solid fa-angle-double-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="af-pagination-item">
                            <span class="af-pagination-link af-pagination-disabled">
                                <i class="fa-solid fa-angle-right"></i>
                            </span>
                        </li>
                        <li class="af-pagination-item">
                            <span class="af-pagination-link af-pagination-disabled">
                                <i class="fa-solid fa-angle-double-right"></i>
                            </span>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
}
