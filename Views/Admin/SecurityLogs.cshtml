@model IEnumerable<AFTRS.Models.SecurityLog>
@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "SecurityLogs");
    var users = ViewBag.Users as IEnumerable<AFTRS.Models.User> ?? new List<AFTRS.Models.User>();
    int? selectedUserId = ViewBag.SelectedUserId as int?;
}

<div class="af-page-header">
    <div>
        <p class="af-kicker">@UiText.T(language, "AdminSecurity")</p>
        <h1 class="af-title">@UiText.T(language, "SecurityLogsTitle")</h1>
    </div>
</div>

<form method="get" class="af-panel mb-6 grid grid-cols-1 md:grid-cols-3 gap-4">
    <div><label class="af-kicker mb-2 block">@UiText.T(language, "FilterByDate")</label><input type="date" name="date" value="@ViewBag.SelectedDate" /></div>
    <div><label class="af-kicker mb-2 block">@UiText.T(language, "FilterByUser")</label><select name="userId"><option value="">@UiText.T(language, "AllUsers")</option>@foreach (var user in users) { <option value="@user.UserID" selected="@(selectedUserId == user.UserID)">@user.Username</option> }</select></div>
    <div class="flex items-end gap-2"><button type="submit" class="af-btn-primary">@UiText.T(language, "ApplyFilter")</button><a asp-action="SecurityLogs" class="af-btn-secondary">@UiText.T(language, "Clear")</a></div>
</form>

<div class="af-table-wrap">
    <table class="af-table">
        <thead><tr><th>@UiText.T(language, "Timestamp")</th><th>@UiText.T(language, "User")</th><th>@UiText.T(language, "IpAddress")</th><th>@UiText.T(language, "Action")</th><th>@UiText.T(language, "Status")</th></tr></thead>
        <tbody>
            @foreach (var log in Model) {
                <tr>
                    <td>@log.Timestamp</td>
                    <td class="font-bold">@log.User?.Username</td>
                    <td class="font-mono text-xs af-muted">@log.IPAddress</td>
                    <td>@log.Action</td>
                    <td><span class="af-badge @(log.IsSuccess ? "af-badge-green" : "af-badge-red")">@(log.IsSuccess ? UiText.T(language, "Success") : UiText.T(language, "Failed"))</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>
