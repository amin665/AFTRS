@{
    var language = UiText.Language(Context.Request);
    var isArabic = language == "ar";
    ViewData["Title"] = UiText.T(language, "ViewCsvGuide");
}

<div class="max-w-4xl mx-auto p-6">
    <h1 class="text-3xl font-bold mb-2 text-gray-800">@(isArabic ? "دليل رفع ملفات CSV / Excel" : "CSV / Excel Upload Guide")</h1>
    <p class="text-gray-500 mb-8">@(isArabic ? "تشرح هذه الصفحة التنسيق الصحيح لاستيراد البيانات المالية إلى AFTRS." : "This page explains the correct file format for importing financial data into AFTRS.")</p>

    <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mb-8 rounded-r-xl">
        <h2 class="font-bold text-blue-800 mb-2">@(isArabic ? "القواعد العامة" : "General Rules")</h2>
        <ul class="list-disc pl-5 text-sm text-blue-900 space-y-1">
            <li>@(isArabic ? "الصيغ المقبولة:" : "Accepted formats:") <strong>.csv</strong> @(isArabic ? "و" : "and") <strong>.xlsx</strong>.</li>
            <li>@(isArabic ? "الحد الأقصى لحجم الملف:" : "Maximum file size:") <strong>25 MB</strong> @(isArabic ? "لكل عملية رفع" : "per upload") (FR-08).</li>
            <li>@(isArabic ? "يجب أن يحتوي الصف الأول على أسماء الأعمدة المطلوبة كما هي موضحة أدناه." : "The first row must be a header row with the exact column names shown below.")</li>
            <li>@(isArabic ? "يتم رفض الملفات المكررة تلقائياً باستخدام SHA-256." : "Duplicate files are automatically rejected using SHA-256.")</li>
            <li>@(isArabic ? "يتم تخطي صفوف المعاملات المكررة حسب التاريخ والمرجع والمبلغ." : "Duplicate transaction rows are skipped by date, reference number, and amount.")</li>
        </ul>
    </div>

    <div class="bg-white rounded-xl shadow p-6 mb-8">
        <h2 class="text-xl font-bold mb-4 text-gray-800">@(isArabic ? "الأعمدة المطلوبة" : "Required Columns")</h2>
        <table class="min-w-full text-sm">
            <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
                <tr>
                    <th class="px-4 py-3 text-left">@(isArabic ? "اسم العمود" : "Column Header")</th>
                    <th class="px-4 py-3 text-left">@UiText.T(language, "Type")</th>
                    <th class="px-4 py-3 text-left">@(isArabic ? "التنسيق / ملاحظات" : "Format / Notes")</th>
                    <th class="px-4 py-3 text-left">@(isArabic ? "مطلوب؟" : "Required?")</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                <tr>
                    <td class="px-4 py-3 font-mono font-bold text-blue-700">Transaction Date</td>
                    <td class="px-4 py-3">@UiText.T(language, "Date")</td>
                    <td class="px-4 py-3">DD/MM/YYYY</td>
                    <td class="px-4 py-3"><span class="bg-red-100 text-red-700 px-2 py-0.5 rounded text-xs font-bold">@(isArabic ? "مطلوب" : "Required")</span></td>
                </tr>
                <tr>
                    <td class="px-4 py-3 font-mono font-bold text-blue-700">Description</td>
                    <td class="px-4 py-3">@(isArabic ? "نص" : "Text")</td>
                    <td class="px-4 py-3">@(isArabic ? "حد أقصى 200 حرف. يستخدمه محرك المطابقة التقريبية." : "Max 200 characters. Used by the fuzzy matching engine.")</td>
                    <td class="px-4 py-3"><span class="bg-red-100 text-red-700 px-2 py-0.5 rounded text-xs font-bold">@(isArabic ? "مطلوب" : "Required")</span></td>
                </tr>
                <tr>
                    <td class="px-4 py-3 font-mono font-bold text-blue-700">Reference Number</td>
                    <td class="px-4 py-3">@(isArabic ? "نص" : "Text")</td>
                    <td class="px-4 py-3">@(isArabic ? "رقم مرجع المعاملة أو الشيك. يستخدم في المطابقة الدقيقة." : "Transaction reference or cheque number. Used for exact matching.")</td>
                    <td class="px-4 py-3"><span class="bg-red-100 text-red-700 px-2 py-0.5 rounded text-xs font-bold">@(isArabic ? "مطلوب" : "Required")</span></td>
                </tr>
                <tr>
                    <td class="px-4 py-3 font-mono font-bold text-blue-700">Amount</td>
                    <td class="px-4 py-3">@(isArabic ? "رقم عشري" : "Decimal")</td>
                    <td class="px-4 py-3">@(isArabic ? "رقم موجب بدقتين عشريتين مثل" : "Positive number with up to 2 decimal places, e.g.") <code>1500.00</code>. LYD.</td>
                    <td class="px-4 py-3"><span class="bg-red-100 text-red-700 px-2 py-0.5 rounded text-xs font-bold">@(isArabic ? "مطلوب" : "Required")</span></td>
                </tr>
                <tr>
                    <td class="px-4 py-3 font-mono text-gray-500">Type</td>
                    <td class="px-4 py-3">@(isArabic ? "نص" : "Text")</td>
                    <td class="px-4 py-3">Credit / Debit. @(isArabic ? "اختياري." : "Optional.")</td>
                    <td class="px-4 py-3"><span class="bg-green-100 text-green-700 px-2 py-0.5 rounded text-xs font-bold">@(isArabic ? "اختياري" : "Optional")</span></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="bg-white rounded-xl shadow p-6 mb-8">
        <h2 class="text-xl font-bold mb-4 text-gray-800">@(isArabic ? "مثال CSV للسجل الداخلي" : "Example CSV (Internal Ledger)")</h2>
        <pre class="bg-gray-900 text-green-400 rounded-lg p-4 text-sm overflow-x-auto">Transaction Date,Description,Reference Number,Amount,Type
05/01/2026,Monthly Rent Payment,CHQ-001,3500.00,Debit
10/01/2026,LTT Utilities Bill,UTIL-JAN,450.00,Debit
15/01/2026,Salary Transfer - Ahmed,PAY-001,5200.00,Debit
20/01/2026,Client Payment Received,INV-2026-01,12000.00,Credit</pre>
        <p class="text-xs text-gray-400 mt-2">@(isArabic ? "احفظ الملف بترميز UTF-8 للحصول على أفضل توافق." : "Save the file as UTF-8 encoding for best compatibility.")</p>
    </div>

    <div class="bg-white rounded-xl shadow p-6">
        <h2 class="text-xl font-bold mb-4 text-gray-800">@(isArabic ? "الأخطاء الشائعة والحلول" : "Common Errors & Solutions")</h2>
        <table class="min-w-full text-sm">
            <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
                <tr>
                    <th class="px-4 py-3 text-left">@(isArabic ? "الخطأ" : "Error")</th>
                    <th class="px-4 py-3 text-left">@(isArabic ? "السبب" : "Cause")</th>
                    <th class="px-4 py-3 text-left">@(isArabic ? "الحل" : "Solution")</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                <tr>
                    <td class="px-4 py-3 text-red-600 font-medium">@(isArabic ? "خطأ في قراءة الملف" : "File parsing error")</td>
                    <td class="px-4 py-3">@(isArabic ? "اسم عمود ناقص أو مكتوب بشكل غير صحيح" : "Missing or misspelled column header")</td>
                    <td class="px-4 py-3">Transaction Date, Description, Reference Number, Amount</td>
                </tr>
                <tr>
                    <td class="px-4 py-3 text-red-600 font-medium">@(isArabic ? "الملف أكبر من 25 MB" : "File exceeds 25 MB")</td>
                    <td class="px-4 py-3">@(isArabic ? "حجم الملف كبير جداً" : "File is too large")</td>
                    <td class="px-4 py-3">@(isArabic ? "قسّم الملف إلى دفعات أصغر." : "Split the file into smaller batches.")</td>
                </tr>
                <tr>
                    <td class="px-4 py-3 text-red-600 font-medium">@(isArabic ? "ملف مكرر" : "Duplicate file detected")</td>
                    <td class="px-4 py-3">@(isArabic ? "تم رفع نفس محتوى الملف سابقاً" : "Same file content was uploaded before")</td>
                    <td class="px-4 py-3">@(isArabic ? "راجع سجل الملفات المرفوعة." : "Check the upload history table.")</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
