@{
    ViewData["Title"] = "CSV Upload Guide";
}

<div class="max-w-4xl mx-auto p-6">
    <h1 class="text-3xl font-bold mb-2 text-gray-800">📄 CSV / Excel Upload Guide</h1>
    <p class="text-gray-500 mb-8">SRS §3.6 — This page explains the correct file format for importing financial data into AFTRS.</p>

    <!-- General Rules -->
    <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mb-8 rounded-r-xl">
        <h2 class="font-bold text-blue-800 mb-2">General Rules</h2>
        <ul class="list-disc pl-5 text-sm text-blue-900 space-y-1">
            <li>Accepted formats: <strong>.csv</strong> (Comma-Separated Values) and <strong>.xlsx</strong> (Excel).</li>
            <li>Maximum file size: <strong>25 MB</strong> per upload (FR-08).</li>
            <li>The first row must be a <strong>header row</strong> with the exact column names shown below.</li>
            <li>Duplicate files (same content or same name) will be automatically rejected (FR-09a).</li>
            <li>Duplicate transaction rows (same Reference + Date + Amount) will be silently skipped (FR-09b).</li>
        </ul>
    </div>

    <!-- Required Columns -->
    <div class="bg-white rounded-xl shadow p-6 mb-8">
        <h2 class="text-xl font-bold mb-4 text-gray-800">Required Columns</h2>
        <table class="min-w-full text-sm">
            <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
                <tr>
                    <th class="px-4 py-3 text-left">Column Header</th>
                    <th class="px-4 py-3 text-left">Type</th>
                    <th class="px-4 py-3 text-left">Format / Notes</th>
                    <th class="px-4 py-3 text-left">Required?</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                <tr>
                    <td class="px-4 py-3 font-mono font-bold text-blue-700">Date</td>
                    <td class="px-4 py-3">Date</td>
                    <td class="px-4 py-3">DD/MM/YYYY &nbsp;or&nbsp; YYYY-MM-DD (ISO 8601 recommended)</td>
                    <td class="px-4 py-3"><span class="bg-red-100 text-red-700 px-2 py-0.5 rounded text-xs font-bold">Required</span></td>
                </tr>
                <tr>
                    <td class="px-4 py-3 font-mono font-bold text-blue-700">Description</td>
                    <td class="px-4 py-3">Text</td>
                    <td class="px-4 py-3">Max 200 characters. Used by the Fuzzy Matching engine (FR-11).</td>
                    <td class="px-4 py-3"><span class="bg-red-100 text-red-700 px-2 py-0.5 rounded text-xs font-bold">Required</span></td>
                </tr>
                <tr>
                    <td class="px-4 py-3 font-mono font-bold text-blue-700">Reference</td>
                    <td class="px-4 py-3">Text</td>
                    <td class="px-4 py-3">Transaction reference / cheque number. Used for Exact Match (FR-10).</td>
                    <td class="px-4 py-3"><span class="bg-red-100 text-red-700 px-2 py-0.5 rounded text-xs font-bold">Required</span></td>
                </tr>
                <tr>
                    <td class="px-4 py-3 font-mono font-bold text-blue-700">Amount</td>
                    <td class="px-4 py-3">Decimal</td>
                    <td class="px-4 py-3">Positive number with up to 2 decimal places (e.g. <code>1500.00</code>). Use LYD.</td>
                    <td class="px-4 py-3"><span class="bg-red-100 text-red-700 px-2 py-0.5 rounded text-xs font-bold">Required</span></td>
                </tr>
                <tr>
                    <td class="px-4 py-3 font-mono text-gray-500">Type</td>
                    <td class="px-4 py-3">Text</td>
                    <td class="px-4 py-3">Either <code>Credit</code> or <code>Debit</code>. If omitted, the field is left blank.</td>
                    <td class="px-4 py-3"><span class="bg-green-100 text-green-700 px-2 py-0.5 rounded text-xs font-bold">Optional</span></td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Example CSV -->
    <div class="bg-white rounded-xl shadow p-6 mb-8">
        <h2 class="text-xl font-bold mb-4 text-gray-800">Example CSV (Internal Ledger)</h2>
        <pre class="bg-gray-900 text-green-400 rounded-lg p-4 text-sm overflow-x-auto">Date,Description,Reference,Amount,Type
2026-01-05,Monthly Rent Payment,CHQ-001,3500.00,Debit
2026-01-10,LTT Utilities Bill,UTIL-JAN,450.00,Debit
2026-01-15,Salary Transfer - Ahmed,PAY-001,5200.00,Debit
2026-01-20,Client Payment Received,INV-2026-01,12000.00,Credit</pre>
        <p class="text-xs text-gray-400 mt-2">Save the file as UTF-8 encoding for best compatibility.</p>
    </div>

    <!-- Example Excel -->
    <div class="bg-white rounded-xl shadow p-6 mb-8">
        <h2 class="text-xl font-bold mb-4 text-gray-800">Example Excel (Bank Statement)</h2>
        <p class="text-sm text-gray-600 mb-3">For <strong>.xlsx</strong> files, ensure the first row contains the exact column headers. Dates must be stored as real date values (not plain text) in Excel for correct parsing.</p>
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm border border-gray-200 rounded">
                <thead class="bg-gray-100 text-gray-700">
                    <tr>
                        <th class="border px-4 py-2">Date</th>
                        <th class="border px-4 py-2">Description</th>
                        <th class="border px-4 py-2">Reference</th>
                        <th class="border px-4 py-2">Amount</th>
                        <th class="border px-4 py-2">Type</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    <tr>
                        <td class="border px-4 py-2">05/01/2026</td>
                        <td class="border px-4 py-2">Cheque Withdrawal – Rent</td>
                        <td class="border px-4 py-2">CHQ-001</td>
                        <td class="border px-4 py-2">3500.00</td>
                        <td class="border px-4 py-2">Debit</td>
                    </tr>
                    <tr>
                        <td class="border px-4 py-2">10/01/2026</td>
                        <td class="border px-4 py-2">Online Bill – Utilities LTT</td>
                        <td class="border px-4 py-2">UTIL-JAN</td>
                        <td class="border px-4 py-2">450.00</td>
                        <td class="border px-4 py-2">Debit</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Common Errors -->
    <div class="bg-white rounded-xl shadow p-6">
        <h2 class="text-xl font-bold mb-4 text-gray-800">Common Errors &amp; Solutions</h2>
        <table class="min-w-full text-sm">
            <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
                <tr>
                    <th class="px-4 py-3 text-left">Error</th>
                    <th class="px-4 py-3 text-left">Cause</th>
                    <th class="px-4 py-3 text-left">Solution</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                <tr>
                    <td class="px-4 py-3 text-red-600 font-medium">Error parsing CSV</td>
                    <td class="px-4 py-3">Missing or misspelled column header</td>
                    <td class="px-4 py-3">Ensure columns are named exactly: <code>Date, Description, Reference, Amount</code></td>
                </tr>
                <tr>
                    <td class="px-4 py-3 text-red-600 font-medium">File exceeds 25 MB</td>
                    <td class="px-4 py-3">File is too large</td>
                    <td class="px-4 py-3">Split the file into smaller batches and upload separately.</td>
                </tr>
                <tr>
                    <td class="px-4 py-3 text-red-600 font-medium">Duplicate file detected</td>
                    <td class="px-4 py-3">Same file content already uploaded</td>
                    <td class="px-4 py-3">Check the Upload History table. If re-uploading intentionally, cancel the current session and start a new one.</td>
                </tr>
                <tr>
                    <td class="px-4 py-3 text-red-600 font-medium">Amount format error</td>
                    <td class="px-4 py-3">Amount contains currency symbols (e.g. <code>LYD 450</code>)</td>
                    <td class="px-4 py-3">Remove all currency symbols. Use plain numbers only (e.g. <code>450.00</code>).</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
