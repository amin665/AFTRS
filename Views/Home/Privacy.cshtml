@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "PrivacyPolicy");
}

<div class="af-card max-w-3xl mx-auto">
    <p class="af-kicker">AFTRS</p>
    <h1 class="af-title !text-3xl">@ViewData["Title"]</h1>
    <p class="af-muted mt-4">@UiText.T(language, "PrivacyText")</p>
</div>
