@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "ManagerDashboard");
    var totalCount = ViewBag.TotalCount ?? 0;
    var reconciledCount = ViewBag.ReconciledCount ?? 0;
    var discrepancyCount = ViewBag.DiscrepancyCount ?? 0;
    var matchPercent = ViewBag.MatchPercent ?? 0;
    ViewData["HideFooter"] = true;
}

<div class="af-page-header">
    <div>
        <p class="af-kicker">@UiText.T(language, "CommandCenter")</p>
        <h1 class="af-title">@UiText.T(language, "ManagerDashboard")</h1>
        <p class="af-subtitle">@UiText.T(language, "OperationalOverview")</p>
    </div>
    <span class="af-badge af-badge-cyan">
        <i class="fa-solid fa-user-tie"></i> @UiText.T(language, "RoleLabel"): @UiText.T(language, "FinancialManager")
    </span>
</div>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <section class="af-panel af-glow-cyan xl:col-span-2">
        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
            <div>
                <p class="af-kicker">@UiText.T(language, "SystemProgress")</p>
                <h2 class="text-2xl font-black mt-2">@UiText.T(language, "MatchRate")</h2>
                <p class="af-muted mt-2">@ViewBag.LedgerCount @UiText.T(language, "Ledger") / @ViewBag.BankCount @UiText.T(language, "Bank") @UiText.T(language, "Records")</p>
            </div>
            <div class="af-ring relative" style="--value:@matchPercent">
                <span>@matchPercent%</span>
            </div>
        </div>
        <div class="af-progress mt-8"><span style="width: @matchPercent%"></span></div>
        <div class="af-stat-strip mt-6">
            <div class="af-stat-mini">
                <p class="af-kicker">@UiText.T(language, "TotalTransactions")</p>
                <p class="text-3xl font-black mt-1">@totalCount</p>
            </div>
            <div class="af-stat-mini">
                <p class="af-kicker">@UiText.T(language, "Reconciled")</p>
                <p class="text-3xl font-black mt-1 text-green-500">@reconciledCount</p>
            </div>
        </div>
    </section>

    <section class="af-panel af-glow-magenta">
        <p class="af-kicker">@UiText.T(language, "PendingDiscrepancies")</p>
        <p class="af-value text-red-500">@discrepancyCount</p>
        <p class="af-muted mb-6">@UiText.T(language, "RequiresManualResolution")</p>
        <a asp-controller="Resolve" asp-action="Index" class="af-btn-primary w-full">
            <i class="fa-solid fa-screwdriver-wrench"></i> @UiText.T(language, "OpenWorkbench")
        </a>
    </section>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
    <section class="af-card">
        <div class="flex items-center justify-between gap-4">
            <div>
                <p class="af-kicker">@UiText.T(language, "DataImport")</p>
                <h3 class="text-xl font-black mt-2">CSV / XLSX</h3>
            </div>
            <i class="fa-solid fa-file-import text-3xl text-cyan-400"></i>
        </div>
        <p class="af-muted mt-4">@UiText.T(language, "UploadLedger") / @UiText.T(language, "UploadBankStatement") . SHA-256.</p>
        <a asp-controller="Import" asp-action="Index" class="af-btn-secondary w-full mt-6">@UiText.T(language, "OpenImport")</a>
    </section>

    <section class="af-card">
        <div class="flex items-center justify-between gap-4">
            <div>
                <p class="af-kicker">@UiText.T(language, "RunEngine")</p>
                <h3 class="text-xl font-black mt-2">@UiText.T(language, "RunReconciliation")</h3>
            </div>
            <i class="fa-solid fa-microchip text-3xl text-purple-400"></i>
        </div>
        <p class="af-muted mt-4">@UiText.T(language, "AutoReconciled") / @UiText.T(language, "ManualReconciled") / @UiText.T(language, "Discrepancy")</p>
        <a asp-controller="Reconcile" asp-action="Index" class="af-btn-secondary w-full mt-6">@UiText.T(language, "RunReconciliation")</a>
    </section>

    <section class="af-card">
        <div class="flex items-center justify-between gap-4">
            <div>
                <p class="af-kicker">@UiText.T(language, "Intelligence")</p>
                <h3 class="text-xl font-black mt-2">@UiText.T(language, "ViewIntelligence")</h3>
            </div>
            <i class="fa-solid fa-chart-line text-3xl text-green-400"></i>
        </div>
        <p class="af-muted mt-4">@UiText.T(language, "BudgetActualTitle")</p>
        <a asp-controller="Strategic" asp-action="Index" class="af-btn-secondary w-full mt-6">@UiText.T(language, "ViewIntelligence")</a>
    </section>
</div>
