@model AFTRS.ViewModels.ResolutionViewModel
@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "DiscrepancyWorkbench");
}

<div class="af-page-header">
    <div>
        <p class="af-kicker">@UiText.T(language, "Discrepancy")</p>
        <h1 class="af-title">@UiText.T(language, "DiscrepancyWorkbench")</h1>
    </div>
</div>

@if (TempData["Msg"] != null)
{
    <div class="af-alert mb-6">@TempData["Msg"]</div>
}

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <section class="af-panel af-glow-cyan">
        <h2 class="text-xl font-black mb-4 text-cyan-400">@UiText.T(language, "LedgerDiscrepancies")</h2>
        <div class="space-y-3">
            @foreach (var item in Model.LedgerDiscrepancies)
            {
                <div class="af-stat-mini space-y-3">
                    <button type="button" class="w-full flex justify-between items-center gap-4 text-start" onclick="selectItem('ledger', @item.TransactionID, this)">
                        <span>@item.Description</span>
                        <span class="font-black">@item.Amount LYD</span>
                    </button>
                    <form asp-action="SaveDiscrepancyComment" method="post" class="flex flex-col sm:flex-row gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="transactionId" value="@item.TransactionID" />
                        <input name="comment" value="@item.DiscrepancyComment" placeholder="@UiText.T(language, "DiscrepancyComment")" class="flex-1" maxlength="1000" />
                        <button type="submit" class="af-btn-secondary">@UiText.T(language, "SaveComment")</button>
                    </form>
                </div>
            }
        </div>
    </section>

    <section class="af-panel af-glow-magenta">
        <h2 class="text-xl font-black mb-4 text-purple-400">@UiText.T(language, "BankDiscrepancies")</h2>
        <div class="space-y-3">
            @foreach (var item in Model.BankDiscrepancies)
            {
                <div class="af-stat-mini space-y-3">
                    <button type="button" class="w-full flex justify-between items-center gap-4 text-start" onclick="selectItem('bank', @item.TransactionID, this)">
                        <span>@item.Description</span>
                        <span class="font-black">@item.Amount LYD</span>
                    </button>
                    <form asp-action="SaveDiscrepancyComment" method="post" class="flex flex-col sm:flex-row gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="transactionId" value="@item.TransactionID" />
                        <input name="comment" value="@item.DiscrepancyComment" placeholder="@UiText.T(language, "DiscrepancyComment")" class="flex-1" maxlength="1000" />
                        <button type="submit" class="af-btn-secondary">@UiText.T(language, "SaveComment")</button>
                    </form>
                </div>
            }
        </div>
    </section>
</div>

<section id="actionArea" class="af-panel mt-6 hidden">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p>@UiText.T(language, "SelectedLedgerId"): <span id="displayLedger" class="font-black text-cyan-400">0</span> + @UiText.T(language, "BankId"): <span id="displayBank" class="font-black text-purple-400">0</span></p>
        <button type="button" onclick="openAuditModal()" class="af-btn-success">@UiText.T(language, "ForceMatch")</button>
    </div>
</section>

<div id="auditModal" class="fixed inset-0 bg-black/70 hidden items-center justify-center z-50 p-4">
    <div class="af-card w-full max-w-md">
        <h2 class="text-2xl font-black mb-2">@UiText.T(language, "AuditCommentRequired")</h2>
        <p class="af-muted mb-5">@UiText.T(language, "ManualLinkWarning")</p>
        <form asp-action="ForceMatch" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ledgerId" id="inputLedger" />
            <input type="hidden" name="bankId" id="inputBank" />
            <textarea name="comment" placeholder="@UiText.T(language, "ReasonManualMatch")" required class="min-h-28"></textarea>
            <div class="flex justify-end gap-2">
                <button type="button" onclick="closeAuditModal()" class="af-btn-secondary">@UiText.T(language, "Cancel")</button>
                <button type="submit" class="af-btn-success">@UiText.T(language, "ConfirmLog")</button>
            </div>
        </form>
    </div>
</div>

<script>
    let selectedLedger = null;
    let selectedBank = null;

    function selectItem(type, id, element) {
        if (type === 'ledger') {
            document.querySelectorAll('[onclick*="ledger"]').forEach(el => el.classList.remove('ring-2', 'ring-cyan-400'));
            selectedLedger = id;
            element.classList.add('ring-2', 'ring-cyan-400');
            document.getElementById('displayLedger').innerText = id;
            document.getElementById('inputLedger').value = id;
        } else {
            document.querySelectorAll('[onclick*="bank"]').forEach(el => el.classList.remove('ring-2', 'ring-purple-400'));
            selectedBank = id;
            element.classList.add('ring-2', 'ring-purple-400');
            document.getElementById('displayBank').innerText = id;
            document.getElementById('inputBank').value = id;
        }

        if (selectedLedger && selectedBank) document.getElementById('actionArea').classList.remove('hidden');
    }

    function openAuditModal() { document.getElementById('auditModal').classList.remove('hidden'); document.getElementById('auditModal').classList.add('flex'); }
    function closeAuditModal() { document.getElementById('auditModal').classList.add('hidden'); document.getElementById('auditModal').classList.remove('flex'); }
</script>
