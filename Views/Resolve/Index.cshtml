@model AFTRS.ViewModels.ResolutionViewModel

<div class="p-6">
    <h1 class="text-2xl font-bold mb-6">Discrepancy Resolution Workbench</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- LEFT: Ledger Items -->
        <div class="bg-white p-4 rounded-xl shadow border-t-4 border-blue-500">
            <h3 class="font-bold text-blue-700 mb-4 uppercase text-sm">Unmatched Ledger Items</h3>
            <div class="space-y-2">
                @foreach (var item in Model.UnmatchedLedger)
                {
                    <div class="flex justify-between items-center p-3 border rounded hover:bg-blue-50 cursor-pointer" onclick="selectItem('ledger', @item.Id, this)">
                        <span>@item.Description</span>
                        <span class="font-bold">@item.Amount LYD</span>
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT: Bank Items -->
        <div class="bg-white p-4 rounded-xl shadow border-t-4 border-purple-500">
            <h3 class="font-bold text-purple-700 mb-4 uppercase text-sm">Unmatched Bank Items</h3>
            <div class="space-y-2">
                @foreach (var item in Model.UnmatchedBank)
                {
                    <div class="flex justify-between items-center p-3 border rounded hover:bg-purple-50 cursor-pointer" onclick="selectItem('bank', @item.Id, this)">
                        <span>@item.Description</span>
                        <span class="font-bold">@item.Amount LYD</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Match Action Area -->
    <div id="actionArea" class="mt-8 bg-gray-800 text-white p-6 rounded-xl hidden">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <p>Selected Ledger ID: <span id="displayLedger" class="font-bold text-blue-400">0</span> + Bank ID: <span id="displayBank" class="font-bold text-purple-400">0</span></p>
            
            <form asp-action="ForceMatch" method="post" class="flex gap-2 w-full md:w-auto">
                <input type="hidden" name="ledgerId" id="inputLedger" />
                <input type="hidden" name="bankId" id="inputBank" />
                <input type="text" name="comment" placeholder="Mandatory Justification (e.g. Typo in Ref)" required class="text-black px-4 py-2 rounded-lg flex-grow" />
                <button type="submit" class="bg-green-500 hover:bg-green-600 px-6 py-2 rounded-lg font-bold">FORCE MATCH</button>
            </form>
        </div>
    </div>
</div>

<script>
    let selectedLedger = null;
    let selectedBank = null;

    function selectItem(type, id, element) {
        if (type === 'ledger') {
            document.querySelectorAll('[onclick*="ledger"]').forEach(el => el.classList.remove('bg-blue-200', 'border-blue-500'));
            selectedLedger = id;
            element.classList.add('bg-blue-200', 'border-blue-500');
            document.getElementById('displayLedger').innerText = id;
            document.getElementById('inputLedger').value = id;
        } else {
            document.querySelectorAll('[onclick*="bank"]').forEach(el => el.classList.remove('bg-purple-200', 'border-purple-500'));
            selectedBank = id;
            element.classList.add('bg-purple-200', 'border-purple-500');
            document.getElementById('displayBank').innerText = id;
            document.getElementById('inputBank').value = id;
        }

        if (selectedLedger && selectedBank) {
            document.getElementById('actionArea').classList.remove('hidden');
        }
    }
</script>