@model AFTRS.ViewModels.LoginViewModel
@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "Login");
}

<div class="af-auth-page">
    <div class="af-card af-auth-card af-glow-cyan">
        <div class="text-center mb-8">
            <div class="af-brand-mark mx-auto mb-4">A</div>
            <p class="af-kicker">@UiText.T(language, "SecurePortal")</p>
            <h1 class="af-title !text-3xl mt-2">@UiText.T(language, "LoginTitle")</h1>
            <p class="af-muted mt-2">@UiText.T(language, "AuthorizedUseOnly")</p>
        </div>

        <form class="space-y-5" asp-action="Login" method="post">
            <div asp-validation-summary="All" class="text-red-500 text-sm"></div>

            <div>
                <label asp-for="Email" class="af-kicker mb-2 block">@UiText.T(language, "EmailAddress")</label>
                <input asp-for="Email" placeholder="@UiText.T(language, "EmailAddress")" />
            </div>
            <div>
                <label asp-for="Password" class="af-kicker mb-2 block">@UiText.T(language, "Password")</label>
                <input asp-for="Password" placeholder="@UiText.T(language, "Password")" />
            </div>

            <div class="flex items-center justify-between gap-3">
                <label class="flex items-center gap-2 text-sm af-muted">
                    <input asp-for="RememberMe" class="h-4 w-4 rounded" />
                    <span>@UiText.T(language, "RememberMe")</span>
                </label>
                <a href="#" class="text-sm font-bold text-cyan-500">@UiText.T(language, "ForgotPassword")</a>
            </div>

            <button type="submit" class="af-btn-primary w-full">@UiText.T(language, "Login")</button>
        </form>
    </div>
</div>
