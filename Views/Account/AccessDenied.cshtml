@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "AccessDenied");
}

<div class="af-auth-page">
    <div class="af-card af-auth-card af-glow-magenta text-center">
        <i class="fa-solid fa-ban text-5xl text-red-500 mb-5"></i>
        <h1 class="af-title !text-3xl">@UiText.T(language, "AccessDenied")</h1>
        <p class="af-muted mt-3">@UiText.T(language, "NoPermission")</p>
        <a asp-controller="Home" asp-action="Index" class="af-btn-primary mt-8">@UiText.T(language, "ReturnDashboard")</a>
    </div>
</div>
