@model AFTRS.ViewModels.RegisterViewModel
@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "Register");
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-white p-10 rounded-xl shadow-lg border border-gray-100">
        <h2 class="text-center text-3xl font-extrabold text-gray-900">@UiText.T(language, "CreateAccount")</h2>
        
        <form class="mt-8 space-y-6" asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-red-500 text-sm"></div>
            
            <div class="space-y-4">
                <input asp-for="Email" class="appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" placeholder="@UiText.T(language, "EmailAddress")">
                
                <input asp-for="Password" class="appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" placeholder="@UiText.T(language, "Password")">
                
                <input asp-for="ConfirmPassword" class="appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" placeholder="@UiText.T(language, "ConfirmPassword")">
                <p class="text-xs text-gray-500">@UiText.T(language, "DefaultManagerRole")</p>
            </div>

            <button type="submit" class="w-full py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700">
                @UiText.T(language, "Register")
            </button>
        </form>
    </div>
</div>
