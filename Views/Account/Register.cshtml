@model AFTRS.ViewModels.RegisterViewModel
@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "Register");
}

<div class="af-auth-page">
    <div class="af-card af-auth-card af-glow-green">
        <div class="text-center mb-8">
            <div class="af-brand-mark mx-auto mb-4">A</div>
            <p class="af-kicker">@UiText.T(language, "Enrollment")</p>
            <h1 class="af-title !text-3xl mt-2">@UiText.T(language, "CreateAccount")</h1>
            <p class="af-muted mt-2">@UiText.T(language, "DefaultManagerRole")</p>
        </div>

        <form class="space-y-5" asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-red-500 text-sm"></div>
            <input asp-for="Email" placeholder="@UiText.T(language, "EmailAddress")" />
            <input asp-for="Password" placeholder="@UiText.T(language, "Password")" />
            <input asp-for="ConfirmPassword" placeholder="@UiText.T(language, "ConfirmPassword")" />
            <button type="submit" class="af-btn-success w-full">@UiText.T(language, "Register")</button>
        </form>
    </div>
</div>
