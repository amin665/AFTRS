@model IEnumerable<AFTRS.Models.Template>
@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "Templates");
}

<div class="af-page-header">
    <div>
        <p class="af-kicker">@UiText.T(language, "Templates")</p>
        <h1 class="af-title">@UiText.T(language, "Templates")</h1>
        <p class="af-subtitle">@UiText.T(language, "TemplatesHelp")</p>
    </div>
    <a asp-action="Create" class="af-btn-primary"><i class="fa-solid fa-plus"></i> @UiText.T(language, "NewTemplate")</a>
</div>

@if (TempData["Msg"] != null)
{
    <div class="af-alert af-alert-success">@TempData["Msg"]</div>
}

<div class="af-table-wrap">
    <table class="af-table">
        <thead>
            <tr>
                <th>@UiText.T(language, "Description")</th>
                <th>@UiText.T(language, "Category")</th>
                <th>@UiText.T(language, "Amount")</th>
                <th>@UiText.T(language, "Frequency")</th>
                <th>@UiText.T(language, "NextRun")</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td class="font-bold">@t.DescriptionName</td>
                <td class="af-muted">@t.Category?.Name</td>
                <td class="font-black">@t.Amount.ToString("N2") LYD</td>
                <td><span class="af-badge af-badge-purple">@t.Frequency</span></td>
                <td>@t.NextRunDate.ToString("dd/MM/yyyy")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
