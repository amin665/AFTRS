@model IEnumerable<AFTRS.Models.Template>
@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "Templates");
    var categories = ViewBag.Categories as IEnumerable<AFTRS.Models.Category> ?? new List<AFTRS.Models.Category>();
}

<div class="p-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold">@UiText.T(language, "Templates")</h1>
        <a asp-action="Create" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">@UiText.T(language, "NewTemplate")</a>
    </div>

    @if (TempData["Msg"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
            @TempData["Msg"]
        </div>
    }

    <div class="bg-white rounded-xl shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">@UiText.T(language, "Description")</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">@UiText.T(language, "Category")</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">@UiText.T(language, "Amount")</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">@UiText.T(language, "Frequency")</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">@UiText.T(language, "NextRun")</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
            @foreach (var t in Model)
            {
                <tr>
                    <td class="px-6 py-4">@t.DescriptionName</td>
                    <td class="px-6 py-4 text-gray-600">@t.Category?.Name</td>
                    <td class="px-6 py-4 font-bold">@t.Amount.ToString("N2") LYD</td>
                    <td class="px-6 py-4">@t.Frequency</td>
                    <td class="px-6 py-4">@t.NextRunDate.ToString("dd/MM/yyyy")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="mt-6 text-sm text-gray-600">
        @UiText.T(language, "TemplatesHelp")
    </div>
</div>
