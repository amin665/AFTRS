@model AFTRS.Models.Template
@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "CreateTemplate");
    var categories = ViewBag.Categories as IEnumerable<AFTRS.Models.Category> ?? new List<AFTRS.Models.Category>();
}

<div class="max-w-xl mx-auto mt-10 bg-white p-8 rounded-xl shadow">
    <h1 class="text-2xl font-bold mb-6">@UiText.T(language, "CreateTemplate")</h1>

    <form asp-action="Create" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-red-600 text-sm"></div>

        <div>
            <label class="block text-sm font-medium">@UiText.T(language, "Category")</label>
            <select asp-for="CategoryID" class="w-full border rounded p-2" required>
                <option value="">@UiText.T(language, "Select")</option>
                @foreach (var c in categories)
                {
                    <option value="@c.CategoryID">@c.Name</option>
                }
            </select>
        </div>

        <div>
            <label class="block text-sm font-medium">@UiText.T(language, "DescriptionName")</label>
            <input asp-for="DescriptionName" class="w-full border rounded p-2" maxlength="100" required />
        </div>

        <div>
            <label class="block text-sm font-medium">@UiText.T(language, "AmountLyd")</label>
            <input asp-for="Amount" type="number" step="0.01" class="w-full border rounded p-2" required />
        </div>

        <div>
            <label class="block text-sm font-medium">@UiText.T(language, "Frequency")</label>
            <select asp-for="Frequency" class="w-full border rounded p-2" required>
                <option value="Monthly">@UiText.T(language, "Monthly")</option>
                <option value="Weekly">@UiText.T(language, "Weekly")</option>
            </select>
        </div>

        <div>
            <label class="block text-sm font-medium">@UiText.T(language, "NextRunDate")</label>
            <input asp-for="NextRunDate" type="date" class="w-full border rounded p-2" required />
        </div>

        <div class="flex gap-2">
            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">@UiText.T(language, "Save")</button>
            <a asp-action="Index" class="bg-gray-100 px-4 py-2 rounded hover:bg-gray-200">@UiText.T(language, "Cancel")</a>
        </div>
    </form>
</div>
