@model AFTRS.Models.Template
@{
    ViewData["Title"] = "Create Template";
    var categories = ViewBag.Categories as IEnumerable<AFTRS.Models.Category> ?? new List<AFTRS.Models.Category>();
}

<div class="max-w-xl mx-auto mt-10 bg-white p-8 rounded-xl shadow">
    <h1 class="text-2xl font-bold mb-6">Create Template</h1>

    <form asp-action="Create" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-red-600 text-sm"></div>

        <div>
            <label class="block text-sm font-medium">Category</label>
            <select asp-for="CategoryID" class="w-full border rounded p-2" required>
                <option value="">Select...</option>
                @foreach (var c in categories)
                {
                    <option value="@c.CategoryID">@c.Name</option>
                }
            </select>
        </div>

        <div>
            <label class="block text-sm font-medium">Description Name</label>
            <input asp-for="DescriptionName" class="w-full border rounded p-2" maxlength="100" required />
        </div>

        <div>
            <label class="block text-sm font-medium">Amount (LYD)</label>
            <input asp-for="Amount" type="number" step="0.01" class="w-full border rounded p-2" required />
        </div>

        <div>
            <label class="block text-sm font-medium">Frequency</label>
            <select asp-for="Frequency" class="w-full border rounded p-2" required>
                <option value="Monthly">Monthly</option>
                <option value="Weekly">Weekly</option>
            </select>
        </div>

        <div>
            <label class="block text-sm font-medium">Next Run Date</label>
            <input asp-for="NextRunDate" type="date" class="w-full border rounded p-2" required />
        </div>

        <div class="flex gap-2">
            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Save</button>
            <a asp-action="Index" class="bg-gray-100 px-4 py-2 rounded hover:bg-gray-200">Cancel</a>
        </div>
    </form>
</div>
