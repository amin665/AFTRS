@model AFTRS.Models.Template
@{
    var language = UiText.Language(Context.Request);
    ViewData["Title"] = UiText.T(language, "CreateTemplate");
    var categories = ViewBag.Categories as IEnumerable<AFTRS.Models.Category> ?? new List<AFTRS.Models.Category>();
}

<div class="af-card max-w-2xl mx-auto">
    <div class="mb-6">
        <p class="af-kicker">@UiText.T(language, "Templates")</p>
        <h1 class="af-title !text-3xl">@UiText.T(language, "CreateTemplate")</h1>
    </div>
    <form asp-action="Create" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-red-500 text-sm"></div>
        <div><label class="af-kicker mb-2 block">@UiText.T(language, "Category")</label><select asp-for="CategoryID" required><option value="">@UiText.T(language, "Select")</option>@foreach (var c in categories) { <option value="@c.CategoryID">@c.Name</option> }</select></div>
        <div><label class="af-kicker mb-2 block">@UiText.T(language, "DescriptionName")</label><input asp-for="DescriptionName" maxlength="100" required /></div>
        <div><label class="af-kicker mb-2 block">@UiText.T(language, "AmountLyd")</label><input asp-for="Amount" type="number" step="0.01" required /></div>
        <div><label class="af-kicker mb-2 block">@UiText.T(language, "Frequency")</label><select asp-for="Frequency" required><option value="Monthly">@UiText.T(language, "Monthly")</option><option value="Weekly">@UiText.T(language, "Weekly")</option></select></div>
        <div><label class="af-kicker mb-2 block">@UiText.T(language, "NextRunDate")</label><input asp-for="NextRunDate" type="date" required /></div>
        <div class="flex flex-wrap gap-2"><button type="submit" class="af-btn-primary">@UiText.T(language, "Save")</button><a asp-action="Index" class="af-btn-secondary">@UiText.T(language, "Cancel")</a></div>
    </form>
</div>
